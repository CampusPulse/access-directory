# NOTE: All values (after the = sign) that are in ALL_CAPS need to be replaced with your own values. see the README for details

# these are the credentials for the underlying data storage layers (like admin UI logins and stuff)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=SILO_ADMIN_PASSWORD
POSTGRES_PASSWORD=POSTGRES_PASSWORD
POSTGRES_USER=campuspulseaccess

# these items are for the web application itself to use to connect
DBNAME=campuspulseaccess
DBUSER=campuspulseaccess
DBPWD=POSTGRES_PASSWORD
DBHOST=localhost
S3_URL=http://localhost:9000
S3_KEY=S3_KEY
S3_SECRET=S3_SECRET
BUCKET_NAME=campuspulseaccess

# these items are for setting up proper auth for admin users. Will be optional very soon
CPACCESS_SECRET_KEY=CPACCESS_SECRET_KEY
AUTH0_CLIENT_ID=AUTH0_CLIENT_ID
AUTH0_CLIENT_SECRET=AUTH0_CLIENT_SECRET
AUTH0_DOMAIN=mytenant.us.auth0.com